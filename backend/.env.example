# Copiar a .env (no versionado) y completar. Solo nombres; sin valores reales.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://USUARIO:CONTRASENA@localhost:5432/NOMBRE_BD
TIME_ZONE=UTC
# Opcional: código de país (sin +) para normalizar teléfonos locales de clientes. Por defecto 591.
DEFAULT_PHONE_COUNTRY_CODE=591
# Opcional: interruptor del registro público (POST /api/auth/register/). Por defecto True; en False responde 403.
REGISTRATION_ENABLED=True
# Opcional: proveedor de mensajería. `whatsapp` (por defecto) usa la Cloud API de Meta; `fake` simula sin red.
MESSAGING_PROVIDER=
# Opcional: versión de la Graph API (por defecto v21.0).
WHATSAPP_API_VERSION=
# Secretos de WhatsApp: uno por empresa. Cada variable debe empezar con el prefijo propio de la empresa,
# WHATSAPP_<12 primeros caracteres del id de la empresa, en mayúsculas>_ (la pantalla Configuración → WhatsApp
# lo muestra). El NOMBRE de la variable se escribe en esa pantalla; el valor, nunca. Ejemplo de nombres, sin valores:
WHATSAPP_0123456789AB_TOKEN=
WHATSAPP_0123456789AB_APP_SECRET=
