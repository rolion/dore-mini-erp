# Copiar a .env (no versionado) y completar. Solo nombres; sin valores reales.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://USUARIO:CONTRASENA@localhost:5432/NOMBRE_BD
TIME_ZONE=UTC
# Opcional: código de país (sin +) para normalizar teléfonos locales de clientes. Por defecto 591.
DEFAULT_PHONE_COUNTRY_CODE=591
